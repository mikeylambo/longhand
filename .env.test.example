# A throwaway database for the specs that write rows.
#
# This must NOT be the project in .env.local. The archive is append-only — a
# layer written by a test run cannot be deleted afterwards, only hidden — so
# tests/support/ledger.ts refuses to run against a protected project, refuses
# if these match VITE_SUPABASE_URL, and refuses if they are missing entirely.
#
# Preferred: a local stack. Free, ephemeral, and cannot be production.
#
#   supabase start        # needs Docker
#
# then use the URL and anon key it prints:
#
#   TEST_SUPABASE_URL=http://127.0.0.1:54321
#   TEST_SUPABASE_PUBLISHABLE_KEY=<anon key from `supabase start`>
#
# A second cloud project works too if Docker is not an option. Either way,
# apply supabase/migrations/*.sql in order. Copy this to .env.test.local.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
