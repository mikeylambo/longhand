# A throwaway Supabase project for the specs that write to a database.
#
# This must NOT be the project in .env.local. The archive is append-only — a
# layer written by a test run cannot be deleted afterwards, only hidden — so
# tests/support/ledger.ts refuses to run against the live project, refuses if
# these match VITE_SUPABASE_URL, and refuses if they are missing entirely.
#
# Create a second Supabase project, apply supabase/migrations/*.sql to it in
# order, and copy this file to .env.test.local.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
