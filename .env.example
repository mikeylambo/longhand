# Leave both unset to run in local mode: the relay is faked in the browser and
# nothing is persisted. Set both to write to the real ledger.
#
# Project settings → API. Use the publishable key (sb_publishable_...), never
# the service role key — this is a client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
